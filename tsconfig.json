{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*", "test/**/*", "*.config.ts"],
  "exclude": ["coverage", "node_modules", ".agents"],
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.tsbuildinfo",

    "module": "preserve",
    "target": "esnext",
    "lib": ["ESNext"],
    "types": ["node"],
    "noEmit": true,
    // tsgo and tsgolint default to 4 type checkers that each rebuild Effect's
    // types, which doubles CPU time and swamps the machine when agents lint in
    // parallel. One checker costs about a second of wall time per lint.
    "checkers": 1,
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",

    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,

    // TypeScript ignores this entry. The `effecttsgo` rules in oxlint read
    // their options from it, since oxlint passes them none. Oxlint owns their
    // severities and runs them regardless of `diagnostics`, which only stops
    // the Effect language server from reporting them again at its defaults.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "effectFn": ["span", "untraced"]
      }
    ]
  }
}
